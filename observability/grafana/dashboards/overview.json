          },
          "expr": "cb:error_ratio:rate5m",
          "instant": false,
          "legendFormat": "{{cb_cell}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error ratio, 5 minutes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live: scraped every 15 s, then a 5 minute rate window.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
