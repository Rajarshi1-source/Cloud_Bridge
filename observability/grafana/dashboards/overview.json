      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cb:availability:ratio_rate1h",
          "instant": false,
          "legendFormat": "{{cb_cell}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Availability, 1 hour",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The share of gateway 5xx. Live: scraped every 15 s, then a 5 minute rate window.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "no measurement yet",
          "unit": "percentunit"
        },
        "overrides": []
